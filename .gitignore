# Environment / secrets — never commit
.env
.env.*
!.env.*.example
.env.local

# MCP helper payloads (local only)
mcp_apply_*.json
mcp_execute_*.json
.tmp_*.json

# Local Deno install (used for Edge Function unit tests in CI/dev)
.deno/

# Local AI assistant config / scratch (kept on disk, never committed)
.claude/
CLAUDE.md
.cursor/
AGENTS.md

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Supabase CLI local metadata (do not commit linked project temps)
supabase/.temp/

# Supabase Edge helpers (never commit MCP deploy blobs)
**/supabase/functions/**/.deploy_payload.json
**/supabase/functions/**/*_args_only.json

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
